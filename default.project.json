{
  "name": "roblox-ts-plugin",
  "globIgnorePaths": [
    "**/package.json",
    "**/tsconfig.json"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Plugin": {
        "$path": "out",
        "include": {
          "$path": "include",
          "node_modules": {
            "$className": "Folder",
            "@rbxts": {
              "$path": "node_modules/@rbxts"
            },
            "@rbxts-js": {
              "$path": "node_modules/@rbxts-js"
            }
          }
        }
      }
    }
  }
}